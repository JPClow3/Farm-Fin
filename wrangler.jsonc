{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ─── Identity ───────────────────────────────────────────────────────────────
  "name": "farm-fin",
  "main": ".open-next/worker.js",

  // ─── Build ──────────────────────────────────────────────────────────────────
  // Generates .open-next/ before `wrangler deploy` / `wrangler versions upload`
  // (Workers Builds runs the deploy command right after `npm ci`)
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },

  // ─── Compatibility ──────────────────────────────────────────────────────────
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // ─── Hyperdrive ─────────────────────────────────────────────────────────────
  // Connection pooling for Neon Postgres
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "4ea091cc9f3c420f8979ab1098346833"
    }
  ],

  // ─── Assets (static files built by Next.js / OpenNext) ──────────────────────
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ─── R2 Buckets ─────────────────────────────────────────────────────────────
  // Stores file attachments: NF-e PDFs, boletos, comprovantes de pagamento
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "farm-fin-attachments",
      "preview_bucket_name": "farm-fin-attachments-preview"
    }
  ],

  // ─── KV Namespaces ──────────────────────────────────────────────────────────
  // Used for: rate limiting, session caching, short-lived report cache
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "f6180158d13447e0b8fe63ff62cfae33",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_ID"
    }
  ],

  // ─── Queues ─────────────────────────────────────────────────────────────────
  // Async background jobs: due-date alerts, report generation, LCDPR export
  "queues": {
    "producers": [
      {
        "binding": "ALERT_QUEUE",
        "queue": "farm-fin-alerts"
      },
      {
        "binding": "REPORT_QUEUE",
        "queue": "farm-fin-reports"
      }
    ]
  },

  // ─── Cron Triggers ──────────────────────────────────────────────────────────
  // Scheduled jobs to check for upcoming/overdue payables and send alerts
  "triggers": {
    "crons": [
      "0 8 * * *",   // Daily at 08:00 UTC — due-date alert sweep
      "0 0 * * 1"    // Every Monday at 00:00 UTC — weekly cash flow summary
    ]
  },

  // ─── Environment Variables ──────────────────────────────────────────────────
  // Non-secret config. Secrets must be set via: wrangler secret put <KEY>
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://farm-fin.com",
    "NEXT_PUBLIC_APP_NAME": "Farm-Fin",
    "NEON_AUTH_URL": "https://ep-frosty-scene-acz4585p.neonauth.sa-east-1.aws.neon.tech/neondb/auth"
  },

  // ─── Observability ──────────────────────────────────────────────────────────
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // ─── Environments ───────────────────────────────────────────────────────────
  "env": {
    // Preview environment — used for PR branch deploys
    "preview": {
      "name": "farm-fin-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://preview.farm-fin.com",
        "NEXT_PUBLIC_APP_NAME": "Farm-Fin (Preview)"
      },
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "farm-fin-attachments-preview"
        }
      ]
    },

    // Development environment — local wrangler dev
    "development": {
      "name": "farm-fin-dev",
      "vars": {
        "APP_ENV": "development",
        "APP_URL": "http://localhost:3000",
        "NEXT_PUBLIC_APP_NAME": "Farm-Fin (Dev)"
      }
    }
  }
}
