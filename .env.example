# ===================================================
# Farm-Fin — Environment Variables Configuration Template
# ===================================================

# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth / Session Configuration
NEXTAUTH_SECRET="super-secret-random-jwt-token-farmfin"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 Object Storage (Attachments & Invoices)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="farm-fin-attachments"
R2_PUBLIC_URL="https://attachments.farmfin.agro.br"

# Environment
NODE_ENV="development"
