# ===================================================
# Farm-Fin — Environment Variables Configuration Template
# ===================================================

# Database (Neon Serverless PostgreSQL)
# Local `wrangler dev` Hyperdrive URL belongs in ignored `.env.local`, never in this template.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB=postgres://user:password@127.0.0.1:5432/database?sslmode=require
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth / Session Configuration (Better Auth)
# Required in production: also signs the demo-persona sessions. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Optional: extra origins allowed to call the auth API (comma separated, wildcards allowed)
BETTER_AUTH_TRUSTED_ORIGINS=""

# Optional login methods — each one only appears on /login when configured
# Magic Link by e-mail (sent through Resend)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Farm-Fin <acesso@seu-dominio.com.br>"
# OAuth — callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and /api/auth/callback/microsoft
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Cloudflare R2 Object Storage (Attachments & Invoices)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="farm-fin-attachments"
R2_PUBLIC_URL="https://attachments.farmfin.agro.br"

# Mistral AI (Nota Fiscal OCR & Smart Classification) — server-side only, never sent to the browser
MISTRAL_API_KEY="your-mistral-api-key-here"

# Environment
NODE_ENV="development"

# Sentry error and performance monitoring.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_ORG="joao-paulo-goncalves-santos"
SENTRY_PROJECT="farm-fin"
